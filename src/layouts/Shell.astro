---
import { Font } from 'astro:assets'
import { LANGUAGE_TAG, LOCALES, translator, type Locale } from '../i18n/t'
import { SITE_URL, alternateLinks } from '../lib/pages'
import { THEME_INIT_SCRIPT } from '../lib/theme'
import { IMAGE_FADE_SCRIPT } from '../lib/imageFade'
import '../styles/globals.css'

interface Props {
  locale: Locale
  title: string
  description: string
  /** Path after the locale segment; pages without one (404) get no canonical or alternates. */
  path?: string
  /** The languages this page exists in. */
  locales?: readonly Locale[]
  publishedTime?: string
  jsonLd?: object
  headScript?: string
  image?: string
  imageAlt?: string
  readingFont?: boolean
}

const {
  locale,
  title,
  description,
  path,
  locales = LOCALES,
  publishedTime,
  jsonLd,
  headScript,
  image: ownImage,
  imageAlt,
  readingFont = false,
} = Astro.props
const t = translator(locale)
const ogLocale = (l: Locale) => (l === 'pt' ? 'pt_BR' : 'en_US')
const url = path === undefined ? undefined : `${SITE_URL}/${locale}/${path}`
const image = `${SITE_URL}${ownImage ?? '/og.png'}`
---

<html lang={LANGUAGE_TAG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    {headScript && <script is:inline set:html={headScript} />}
    <script is:inline set:html={THEME_INIT_SCRIPT} />
    <script is:inline set:html={IMAGE_FADE_SCRIPT} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {url && <link rel="canonical" href={url} />}
    {path !== undefined && alternateLinks(path, locales).map((l) => <link rel="alternate" hreflang={l.hreflang} href={l.href} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <Font cssVariable="--font-jetbrains-mono" preload />
    <Font cssVariable="--font-poppins" preload={[{ weight: 700 }]} />
    <Font cssVariable="--font-lexend" preload={readingFont && [{ weight: 400 }]} />

    <meta property="og:site_name" content={t('meta.siteName')} />
    <meta property="og:type" content={publishedTime ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {url && <meta property="og:url" content={url} />}
    <meta property="og:locale" content={ogLocale(locale)} />
    {locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={ogLocale(l)} />)}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? t('meta.ogImageAlt')} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <header>
      <slot name="topbar" />
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
