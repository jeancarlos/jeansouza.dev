---
import { getAllPostsWithContent } from '@/lib/posts'
import { DotBackground } from './DotBackground'
import { Topbar } from './layout/Topbar'
import { DesktopApp } from './DesktopApp'
import { LocaleProvider } from '../i18n/react'
import type { Locale } from '../i18n/t'

interface Props {
  locale: Locale
  initialOpen?: 'blog' | 'resume' | 'more'
  slug?: string
}

const { locale, initialOpen, slug } = Astro.props

// Same data the Next route loaded, read at build time and handed to the island.
const posts = getAllPostsWithContent(locale)
const initialPost = slug ? posts.find((p) => p.slug === slug) : undefined
---

{/*
  The desktop is the same HomeClient the Next build rendered, mounted as one
  island. Nothing about the window manager, chrome, drag or stacking is
  reimplemented for Astro, so appearance and behaviour cannot drift from the
  original — which is the whole point of a 1:1 port.
*/}
<DesktopApp
  client:load
  locale={locale}
  posts={posts}
  initialOpen={initialOpen}
  initialPost={initialPost}
/>
