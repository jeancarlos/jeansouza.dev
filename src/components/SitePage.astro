---
import Shell from '../layouts/Shell.astro'
import Chrome from './Chrome.astro'
import { DesktopApp } from './DesktopApp'
import type { Locale } from '../i18n/t'
import type { Post } from '../lib/posts'
import { pageLocales, pageMeta, pagePath, pageUrl, type Page } from '../lib/pages'
import { structuredData } from '../lib/structuredData'

interface Props {
  locale: Locale
  page: Page
  posts: Post[]
}

const { locale, page, posts } = Astro.props
const { title, description } = pageMeta(page, locale)
const path = pagePath(page)
const post = page.kind === 'post' ? page.post : undefined
const other = locale === 'pt' ? 'en' : 'pt'
const switchTo = pageLocales(page).includes(other) ? page : { kind: 'blog' as const }
---

<Shell
  locale={locale}
  title={title}
  description={description}
  path={path}
  locales={pageLocales(page)}
  publishedTime={post?.date}
  image={post?.ogImage}
  imageAlt={post?.cover.alt}
  jsonLd={structuredData(page, locale)}
  readingFont={page.kind !== 'home' && page.kind !== 'more'}
>
  <Chrome slot="topbar" locale={locale} switchHref={pageUrl(switchTo, other)} page={pageUrl(page, locale)} />
  <DesktopApp client:afterpaint locale={locale} posts={posts} pathname={pageUrl(page, locale)} />
</Shell>
