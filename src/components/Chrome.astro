---
import { translator, type Locale } from '../i18n/t'

interface Props {
  locale: Locale
  /** Path after the locale segment, so the language switch lands on the same page. */
  path: string
}

const { locale, path } = Astro.props
const t = translator(locale)
const other: Locale = locale === 'pt' ? 'en' : 'pt'
const pill =
  'pointer-events-auto relative inline-flex h-6 w-12 cursor-pointer rounded-full from-brand-from to-brand-to p-[2px] transition-all hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-from active:scale-95'
const knob =
  'flex aspect-square h-full items-center justify-center rounded-full from-brand-from to-brand-to text-[9px] font-bold text-white shadow-sm transition-transform duration-200'
const isEn = locale === 'en'
---

<canvas data-starfield aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10"></canvas>
<div class="pointer-events-none fixed inset-x-0 top-0 z-[19] flex h-[75px] items-center justify-between px-4">
  <a
    href={`/${other}/${path}`}
    hreflang={other}
    data-locale-switch
    class:list={[pill, isEn ? 'bg-gradient-to-l' : 'bg-gradient-to-r']}
  >
    <span class="flex h-full w-full rounded-full bg-[var(--button-inner-bg)]">
      <span class:list={[knob, isEn ? 'translate-x-6 bg-gradient-to-l' : 'bg-gradient-to-r']}>
        {locale.toUpperCase()}
      </span>
    </span>
    <span class="sr-only">{t('locale.switchTo').replace('{locale}', other.toUpperCase())}</span>
  </a>
  <button
    type="button"
    role="switch"
    aria-checked="false"
    aria-label={t('theme.toggle')}
    data-theme-toggle
    class:list={[pill, 'bg-gradient-to-r in-data-[theme=light]:bg-gradient-to-l']}
  >
    <span class="flex h-full w-full rounded-full bg-[var(--button-inner-bg)]">
      <span class:list={[knob, 'bg-gradient-to-r in-data-[theme=light]:translate-x-6 in-data-[theme=light]:bg-gradient-to-l']}>
        <svg viewBox="0 0 24 24" fill="currentColor" class="h-3 w-3 in-data-[theme=light]:hidden" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          class="hidden h-3 w-3 in-data-[theme=light]:block"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12"></path>
        </svg>
      </span>
    </span>
  </button>
</div>

<script>
  import '../scripts/chrome'
</script>
