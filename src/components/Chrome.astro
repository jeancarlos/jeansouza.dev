---
import { translator, type Locale } from '../i18n/t'

interface Props {
  locale: Locale
  /** Where the language switch goes: this page in the other language, or that language's blog. */
  switchHref: string
  /** The URL this copy was rendered for; once the windows move away from it, the switch follows them. */
  page?: string
}

const { locale, switchHref, page } = Astro.props
const t = translator(locale)
const other: Locale = locale === 'pt' ? 'en' : 'pt'
const pill =
  'group pointer-events-auto relative inline-flex h-6 w-12 cursor-pointer rounded-full from-brand-from to-brand-to p-[2px] transition-all hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-from active:scale-95'
const knob =
  'flex aspect-square h-full items-center justify-center rounded-full from-bar-from to-brand-to text-[9px] font-bold text-white text-shadow-bar shadow-sm transition-transform duration-200'
const tip =
  'pointer-events-none absolute top-full mt-2 origin-top scale-0 rounded-full bg-gradient-to-r from-brand-from to-brand-to px-3 py-1 text-sm font-normal whitespace-nowrap text-white shadow-md transition-transform duration-300 ease-[var(--ease-spring)] group-hover:scale-100 group-focus-visible:scale-100 motion-reduce:transition-none'
const tipStart = `${tip} left-0 origin-top-left`
const tipEnd = `${tip} right-0 origin-top-right`
const isEn = locale === 'en'
---

<canvas data-topography aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 h-full w-full"></canvas>
<div class="pointer-events-none fixed inset-x-0 top-0 z-[19] flex h-[75px] items-center justify-between px-4">
  <a
    href={switchHref}
    hreflang={other}
    data-locale-switch
    data-page={page}
    aria-label={`${t('locale.label')}. ${t('locale.tip')}`}
    class:list={[pill, isEn ? 'bg-gradient-to-l' : 'bg-gradient-to-r']}
  >
    <span class="flex h-full w-full rounded-full bg-[var(--button-inner-bg)]">
      <span class:list={[knob, isEn ? 'translate-x-6 bg-gradient-to-l' : 'bg-gradient-to-r']}>
        {locale.toUpperCase()}
      </span>
    </span>
    <span aria-hidden="true" class={tipStart}>{t('locale.tip')}</span>
  </a>
  <div class="flex items-center gap-2">
  <button
    type="button"
    aria-pressed="false"
    aria-label={t('motion.label')}
    data-motion-toggle
    data-tip-on={t('motion.tipPaused')}
    data-tip-off={t('motion.tipPlaying')}
    class:list={[pill, 'bg-gradient-to-r']}
  >
    <span class="flex h-full w-full justify-center rounded-full bg-[var(--button-inner-bg)]">
      <span class:list={[knob, 'bg-gradient-to-r']}>
        <svg viewBox="0 0 24 24" fill="currentColor" class="h-3 w-3 in-data-[motion=paused]:hidden" aria-hidden="true">
          <path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"></path>
        </svg>
        <svg viewBox="0 0 24 24" fill="currentColor" class="hidden h-3 w-3 translate-x-px in-data-[motion=paused]:block" aria-hidden="true">
          <path d="M8.5 5.5l10 6.5-10 6.5z"></path>
        </svg>
      </span>
    </span>
    <span aria-hidden="true" data-tip class={tipEnd}></span>
  </button>
  <button
    type="button"
    role="switch"
    aria-checked="false"
    aria-label={t('theme.label')}
    data-theme-toggle
    data-tip-on={t('theme.tipLight')}
    data-tip-off={t('theme.tipDark')}
    class:list={[pill, 'bg-gradient-to-r in-data-[theme=light]:bg-gradient-to-l']}
  >
    <span class="flex h-full w-full rounded-full bg-[var(--button-inner-bg)]">
      <span class:list={[knob, 'bg-gradient-to-r in-data-[theme=light]:translate-x-6 in-data-[theme=light]:bg-gradient-to-l']}>
        <svg viewBox="0 0 24 24" fill="currentColor" class="h-3 w-3 in-data-[theme=light]:hidden" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          class="hidden h-3 w-3 in-data-[theme=light]:block"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12"></path>
        </svg>
      </span>
    </span>
    <span aria-hidden="true" data-tip class={tipEnd}></span>
  </button>
  </div>
</div>

<script>
  import '../scripts/chrome'
</script>
