---
import SitePage from '../../components/SitePage.astro'
import { LOCALES } from '../../i18n/t'
import { loadPosts } from '../../lib/loadPosts'
import { pagePath, sitePages } from '../../lib/pages'

export async function getStaticPaths() {
  const byLocale = await Promise.all(LOCALES.map(loadPosts))
  return LOCALES.flatMap((locale, i) => {
    const posts = byLocale[i]
    return sitePages(posts).map((page) => ({
      params: { locale, path: pagePath(page).replace(/\/$/, '') || undefined },
      props: { locale, page, posts },
    }))
  })
}

const { locale, page, posts } = Astro.props
---

<SitePage locale={locale} page={page} posts={posts} />
