---
import { getCollection } from 'astro:content'
import Shell from '../../../layouts/Shell.astro'
import Desktop from '../../../components/Desktop.astro'
import Chrome from '../../../components/Chrome.astro'
import Head from '../../../components/Head.astro'
import { LOCALES, type Locale } from '../../../i18n/t'

export async function getStaticPaths() {
  const entries = await getCollection('blog')
  return LOCALES.flatMap((locale) => {
    const suffix = `.${locale}`
    return entries
      .filter((e) => e.id.endsWith(suffix))
      .map((e) => ({
        params: { locale, slug: e.id.slice(0, -suffix.length) },
        props: { title: e.data.title, description: e.data.description },
      }))
  })
}

const locale = Astro.params.locale as Locale
const slug = Astro.params.slug as string
const { title, description } = Astro.props
---

<Shell
  locale={locale}
  title={`${title} — Jean Souza`}
  description={description}
  canonical={`https://jeansouza.dev/${locale}/blog/${slug}/`}
>
  <Head slot="head" locale={locale} title={`${title} — Jean Souza`} description={description} path={`blog/${slug}/`} />
  <Chrome slot="topbar" locale={locale} />
  <Desktop slot="desktop" locale={locale}  slug={slug} />
</Shell>
