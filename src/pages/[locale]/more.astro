---
import Shell from '../../layouts/Shell.astro'
import Desktop from '../../components/Desktop.astro'
import Head from '../../components/Head.astro'
import { LOCALES, useTranslations, type Locale } from '../../i18n/t'

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }))
}

const locale = Astro.params.locale as Locale
const t = useTranslations(locale)
---

<Shell
  locale={locale}
  title={`Jean Souza - ${t('windows.more')}`}
  description={t('hero.role')}
  canonical={`https://jeansouza.dev/${locale}/more/`}
>
  <Head slot="head" locale={locale} title={`Jean Souza - ${t('windows.more')}`} description={t('hero.role')} path={'more/'} />
  <Desktop slot="desktop" locale={locale} open="more" />
</Shell>
