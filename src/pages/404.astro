---
import Shell from '../layouts/Shell.astro'

// GitHub Pages serves one 404 for every unmatched path, including English ones,
// so this page cannot know the visitor's locale. It keeps the Portuguese copy
// the Next site shipped and offers both languages as links.
const title = 'Jean Souza - 404'
---

<Shell
  locale="pt"
  title={title}
  description="Essa página não existe (ou foi movida)."
  canonical="https://jeansouza.dev/"
>
  <nav slot="topbar" aria-label="Navegação principal">
    <a href="/pt/">~ jeansouza.dev</a>
  </nav>

  <div slot="desktop">
    <h1>404</h1>
    <p>Essa página não existe (ou foi movida). Recomendo voltar para a home.</p>
    <p>
      <a href="/pt/">Voltar para a home</a>
      <span aria-hidden="true"> · </span>
      <a href="/en/">Back to home</a>
    </p>
  </div>

  <p slot="footer">jeansouza.dev</p>
</Shell>
