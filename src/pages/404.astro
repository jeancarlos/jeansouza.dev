---
import Shell from '../layouts/Shell.astro'
import { translator } from '../i18n/t'

const t = translator('pt')
---

<Shell locale="pt" title={t('meta.notFound.title')} description={t('meta.notFound.description')}>
  <div class="grid min-h-dvh place-content-center gap-4 p-6 text-center font-mono">
    <h1 class="font-display text-brand-text text-3xl font-bold">404</h1>
    <p class="text-brand-text">{t('meta.notFound.description')}</p>
    <p class="text-brand-muted">
      <a class="underline" href="/pt/">Voltar para a home</a>
      <span aria-hidden="true"> · </span>
      <a class="underline" href="/en/" lang="en">Back to home</a>
    </p>
  </div>
</Shell>
